#!/usr/bin/env bash
# Universal Agent Toolkit launcher. No install step, no dependencies.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

for py in python3 python; do
  if command -v "$py" >/dev/null 2>&1; then
    exec "$py" -c 'import sys; sys.path.insert(0, sys.argv[1]); from uat.cli import main; sys.exit(main(sys.argv[2:]))' "$here/src" "$@"
  fi
done

echo "uat: python3 is required but was not found on PATH" >&2
exit 1
