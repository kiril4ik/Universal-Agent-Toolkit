        },
        "mcp": {
          "scope": "project",
          "path": ".vscode/mcp.json",
          "key": "servers",
          "shape": "standard"
        }
      },
      "notes": "VS Code uses the key 'servers', not 'mcpServers'. Path-scoped rules also exist as .github/instructions/*.instructions.md with an applyTo frontmatter key."
    },
    {
      "id": "gemini-cli",
