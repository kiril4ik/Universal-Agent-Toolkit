{
  "$comment": [
    "Agent surface registry. This is the ONLY place tool-specific paths/formats live.",
    "If a tool changes its format, edit this file - never the installer code.",
    "confidence: high = verified against the tool's own docs//behaviour at time of writing;",
    "            medium = widely documented but not re-verified; low = best-effort, please confirm.",
    "surfaces.instructions.style:",
    "  root-pointer   -> a small markdown file at repo root pointing at .agent-toolkit/CORE.md",
    "  dir-rules-md   -> one .md file inside a rules directory",
    "  dir-rules-mdc  -> one .mdc file (YAML frontmatter) inside a rules directory",
    "surfaces.skills.mode: link = symlink to .agent-toolkit/skills (no duplication), null = unsupported",
    "surfaces.mcp.scope: project = we can write it, global = user must configure manually (we emit instructions)",
    "surfaces.hooks: how a tool registers a SessionStart hook. Only declared for agents that actually support one; the session-reminder pack fills it in."
  ],
  "version": 1,
  "shared_files": {
    "AGENTS.md": "Written once when any agent that consumes it is selected."
  },
  "agents": [
    {
      "id": "claude-code",
      "name": "Claude Code",
      "aliases": [
        "claude",
        "claude-cli"
      ],
      "confidence": "high",
      "surfaces": {
        "instructions": {
          "style": "root-pointer",
          "path": "CLAUDE.md"
        },
        "skills": {
          "path": ".claude/skills",
          "mode": "link"
        },
        "commands": {
          "path": ".claude/commands",
          "ext": ".md"
        },
        "subagents": {
          "path": ".claude/agents",
          "ext": ".md"
        },
        "mcp": {
          "scope": "project",
          "path": ".mcp.json",
          "key": "mcpServers",
          "shape": "standard"
        },
        "hooks": {
          "scope": "project",
          "path": ".claude/settings.json",
          "key": "hooks",
          "event": "SessionStart",
          "matcher": "startup|clear|compact"
        }
      },
      "notes": "Only agent with native progressive-disclosure skills, slash commands and subagents. SessionStart hooks let the toolkit put its rules in context every session."
    },
    {
      "id": "cursor",
      "name": "Cursor",
      "aliases": [],
      "confidence": "high",
      "surfaces": {
        "instructions": {
          "style": "dir-rules-mdc",
          "path": ".cursor/rules",
          "filename": "00-agent-toolkit.mdc"
        },
        "also_writes": [
          "AGENTS.md"
        ],
        "skills": {
          "path": null,
          "mode": null
        },
        "mcp": {
          "scope": "project",
          "path": ".cursor/mcp.json",
          "key": "mcpServers",
          "shape": "standard"
        }
      },
      "notes": "MDC frontmatter supports description/globs/alwaysApply. Glob-scoped rules are the closest thing to skills outside Claude Code."
    },
    {
      "id": "codex",
      "name": "OpenAI Codex CLI",
      "aliases": [
        "openai-codex"
      ],
      "confidence": "high",
      "surfaces": {
        "instructions": {
          "style": "root-pointer",
          "path": "AGENTS.md"
        },
        "skills": {
          "path": null,
          "mode": null
        },
        "mcp": {
          "scope": "global",
          "path": "~/.codex/config.toml",
          "key": "mcp_servers",
          "shape": "toml"
        }
      },
      "notes": "MCP is configured globally in TOML, not per project. Installer emits manual setup instructions instead of writing it."
    },
    {
      "id": "copilot",
      "name": "GitHub Copilot / VS Code",
      "aliases": [
