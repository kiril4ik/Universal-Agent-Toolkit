# Copy to deploy.env and fill in. NEVER commit deploy.env.
#
#   cp deploy.env.example deploy.env && chmod 600 deploy.env

# ---- identity -------------------------------------------------------------
APP_NAME=myapp                     # used for paths, nginx site, service name
APP_USER=myapp                     # system user that owns the code
APP_DIR=/srv/myapp                 # releases/, shared/, current/ live here
APP_DOMAIN=example.com             # public hostname
APP_PORT=3000                      # local port the app listens on

# ---- source ---------------------------------------------------------------
# Either clone from git...
APP_REPO=git@github.com:you/myapp.git
APP_REF=main
# ...or rsync from a local working tree (leave APP_REPO empty to use this)
# APP_SOURCE=/path/to/checkout

# ---- lifecycle commands ---------------------------------------------------
# Run inside the release directory. Leave empty to skip.
BUILD_CMD="docker compose build && docker compose up -d"
MIGRATE_CMD=""                     # e.g. "docker compose exec -T app npm run migrate"
RESTART_CMD="docker compose up -d"

# ---- health ---------------------------------------------------------------
HEALTH_PATH=/health                # deploy fails and auto-reverts without this
HEALTH_ATTEMPTS=30                 # polled every 2s

# ---- persistence ----------------------------------------------------------
# Space-separated paths symlinked from shared/ into every release.
SHARED_PATHS="storage/uploads storage/logs"
KEEP_RELEASES=5

# ---- tls ------------------------------------------------------------------
TLS_EMAIL=you@example.com          # for Let's Encrypt; empty disables issuance
# SKIP_TLS=1
# SKIP_FIREWALL=1

# ---- backups --------------------------------------------------------------
BACKUP_DIR=/var/backups/agent-toolkit

# Secrets do NOT belong here. Put them in $APP_DIR/shared/.env on the server,
# owned by $APP_USER with mode 600.
